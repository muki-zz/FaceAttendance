# Object build statements for STATIC_LIBRARY target mbedx509


#############################################
# Order-only phony target for mbedx509

build cmake_object_order_depends_target_mbedx509: phony || cmake_object_order_depends_target_mbedtls

build esp-idf/mbedtls/mbedtls/library/CMakeFiles/mbedx509.dir/pkcs7.c.obj: C_COMPILER__mbedx509_unscanned_ E$:/application/Espressif/frameworks/esp-idf-v5.5.3/components/mbedtls/mbedtls/library/pkcs7.c || cmake_object_order_depends_target_mbedx509
