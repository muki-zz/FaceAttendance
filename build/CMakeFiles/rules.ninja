#############################################
# Rule for re-running cmake.

rule RERUN_CMAKE
  command = E:\application\Espressif\tools\tools\cmake\3.30.2\bin\cmake.exe --regenerate-during-build -SE:\study\share\study_space\esp32\myself\FaceAttend -BE:\study\share\study_space\esp32\myself\FaceAttend\build
  description = Re-running CMake...
  generator = 1


#############################################
# Rule for cleaning additional files.

rule CLEAN_ADDITIONAL
  command = E:\application\Espressif\tools\tools\cmake\3.30.2\bin\cmake.exe -DCONFIG=$CONFIG -P CMakeFiles\clean_additional.cmake
  description = Cleaning additional files...


#############################################
# Rule for cleaning all built files.

rule CLEAN
  command = E:\application\Espressif\tools\tools\ninja\1.12.1\ninja.exe $FILE_ARG -t clean $TARGETS
  description = Cleaning all built files...


#############################################
# Rule for printing all primary targets available.

rule HELP
  command = E:\application\Espressif\tools\tools\ninja\1.12.1\ninja.exe -t targets
  description = All primary targets available:

